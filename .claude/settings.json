{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/secrets/**)",
      "Bash(cat .env*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(dropdb*)",
      "Bash(*DROP DATABASE*)",
      "Bash(*DROP SCHEMA*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git commit*)",
      "Bash(docker compose down -v*)",
      "Bash(*manage.py migrate*)",
      "Bash(*migrate_schemas*)",
      "Bash(*alembic upgrade*)",
      "Bash(*alembic downgrade*)"
    ]
  }
}
