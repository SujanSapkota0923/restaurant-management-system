# RMS local environment template. Placeholders only: never put a real value here.
# Create your own env file with `make init-env` (scripts/dev/init-env.sh), which
# replaces every placeholder secret with a random value and never prints it.

# PostgreSQL container superuser (used only by the container and bootstrap).
POSTGRES_PASSWORD=change-me

# Application database (scripts/db/bootstrap.sh creates the roles and DB).
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=rms
DB_APP_USER=rms_app
DB_APP_PASSWORD=change-me
DB_MIGRATOR_USER=rms_migrator
DB_MIGRATOR_PASSWORD=change-me

# Django
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only, and only behind a proxy that overwrites the header:
# HTTP_X_FORWARDED_PROTO=https
DJANGO_SECURE_PROXY_SSL_HEADER=

# DEBUG, INFO, WARNING, ERROR or CRITICAL
LOG_LEVEL=INFO
